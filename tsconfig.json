{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "strict": true, "noEmitOnError": true, "declaration": true,
    "rootDir": "src", "outDir": "dist", "skipLibCheck": true,
    "verbatimModuleSyntax": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
